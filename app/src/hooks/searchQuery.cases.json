    { "rule": "lowercase", "typed": "Scatter", "sent": "scatter", "countable": true },
    {
      "rule": "white space at the ends",
      "typed": "  scatter  ",
      "sent": "scatter",
      "countable": true
    },
    {
      "rule": "a run of spaces is one",
      "typed": "SCATTER   Plot",
      "sent": "scatter plot",
      "countable": true
    },
    {
      "rule": "tab and newline are spaces",
      "typed": "box\tplot\nmatplotlib",
      "sent": "box plot matplotlib",
      "countable": true
    },
    { "rule": "nothing", "typed": "", "sent": "", "countable": false },
    { "rule": "spaces only", "typed": "   ", "sent": "", "countable": false },
    { "rule": "one character", "typed": "X", "sent": "x", "countable": false },
    {
      "rule": "cut at 40 characters; a comma is no search",
